            "label": "GPT4Free chat interface on mobile"
        }
    ],
    "theme_color": "#ffffff",
    "background_color": "#ffffff",
    "display": "standalone",
    "scope": "/",
    "share_target": {
        "action": "/chat/",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "text": "prompt"
        }
    }
