{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "polli.g4f.dev" }],
      "destination": "/api/pollinations?path=/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "open.g4f.dev" }],
      "destination": "/api/openrouter?path=/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nvidea.g4f.dev" }],
      "destination": "/api/nvidia?path=/:path*"
    },
    {
      "source": "/challenge",
      "destination": "/api/challenge?path=/challenge"
    },
    {
      "source": "/challenge/:path*",
      "destination": "/api/challenge?path=/challenge/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/worker?path=/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/worker/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
