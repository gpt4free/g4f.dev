{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/challenge",
      "destination": "/api/challenge?path=/challenge"
    },
    {
      "source": "/challenge/:path*",
      "destination": "/api/challenge?path=/challenge/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/worker?path=/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/worker/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
